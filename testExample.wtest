import example2.Persona
import example2.Carrera
import example2.Materia

describe "inscripcion a materias" {
  const programacion = new Carrera()
  const tuess = new Carrera()
  const to = new Carrera()
  const epl = new Materia(creditosQueRequiere = 0)
  const mate1 = new Materia(creditosQueRequiere = 0)
  const obj1 = new Materia(creditosQueRequiere = 0)
  const obj2 = new Materia(creditosQueRequiere = 0)
  const obj3 = new Materia(creditosQueRequiere = 0)
  const bdd = new Materia(creditosQueRequiere = 0)
  const pconc = new Materia(creditosQueRequiere = 0)
  const meYa = new Materia(creditosQueRequiere = 0)
  const tYs = new Materia(creditosQueRequiere = 0)
  const economia = new Materia(creditosQueRequiere = 0)
  const desarrolloLocal = new Materia(creditosQueRequiere = 0)
  const lea = new Materia(creditosQueRequiere = 0)
  const cienciasSalud = new Materia(creditosQueRequiere = 0)
  const psicologia = new Materia(creditosQueRequiere = 0)
  const antropologia = new Materia(creditosQueRequiere = 0)
  const sociologia = new Materia(creditosQueRequiere = 0)
  const alex = new Persona()
  
  test "test 1" {
    programacion.materias().add(epl)
    programacion.materias().add(mate1)
    programacion.materias().add(obj1)
    programacion.materias().add(obj2)
    programacion.materias().add(obj3)
    programacion.materias().add(bdd)
    programacion.materias().add(pconc)
    
    tuess.materias().add(meYa)
    tuess.materias().add(tYs)
    tuess.materias().add(economia)
    tuess.materias().add(desarrolloLocal)
    
    to.materias().add(lea)
    to.materias().add(cienciasSalud)
    to.materias().add(psicologia)
    to.materias().add(antropologia)
    to.materias().add(sociologia)
    
    assert.equals(7, programacion.materias().size())
    
    alex.inscribirseA(programacion)
    alex.inscribirseA(tuess)
    
    assert.that(alex.carrerasDeEstudiante().size() == 2)
    assert.that(alex.carrerasDeEstudiante().contains(programacion))
    assert.that(alex.perteneceMateriaACarrerasDeEstudiante(bdd))
    assert.notThat(alex.perteneceMateriaACarrerasDeEstudiante(psicologia))
  }
  
  test "test2" {
    alex.cursarMateriaConNota(mate1, 2)
    alex.cursarMateriaConNota(obj1, 10)
    alex.cursarMateriaConNota(economia, 6)
    alex.cursarMateriaConNota(tYs, 8)
    alex.cursarMateriaConNota(mate1, 8)
    alex.cursarMateriaConNota(bdd, 2)
    
    //lo pongo asi o tengo que poner que da error?
    alex.cursarMateriaConNota(mate1, 7)
    
    alex.cursarMateriaConNota(bdd, 12)
    
    assert.that(alex.materiasAprobadas().contains(mate1))
    assert.notThat(alex.materiasAprobadas().contains(bdd))
    
    assert.equals(alex.promedioMateriasAprobadasEn(programacion), 9)
    assert.equals(alex.cantidadDeMateriasAprobadasEnCarrera(programacion), 2)
  }
}